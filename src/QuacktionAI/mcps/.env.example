# Any long random string, e.g. `openssl rand -base64 32`.
# Encrypts the tokens this app issues. Changing it invalidates every issued token.
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (type: Web application). Needed for Gmail / Calendar / Meet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps). Needed for GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO) app (developer.atlassian.com/console/myapps). Needed for Jira.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Optional: your public URL, no trailing slash. Defaults to the request origin.
# APP_URL=https://your-app.vercel.app
